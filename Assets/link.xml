<!-- Keep whole assemblies the linker could trim through reflection (stripping is Minimal, this is belt and braces) -->
<linker>
  <assembly fullname="StreetEmpire.Runtime" preserve="all"/>
  <assembly fullname="StreetEmpire.Sim" preserve="all"/>
  <assembly fullname="Unity.InputSystem" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Cinemachine" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="glTFast" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Netcode.Runtime" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Networking.Transport" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="UnityEngine.UI" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="UnityEngine.JSONSerializeModule" preserve="all" ignoreIfMissing="1"/>
</linker>
